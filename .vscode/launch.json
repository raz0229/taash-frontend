            ]
        },
        {
            "name": "TaashOnline (Mock Mode)",
            "request": "launch",
            "type": "dart",
            "program": "lib/main.dart",
            "toolArgs": [
                "--dart-define=MOCK_BACKEND=true"
            ]
        }
    ]
}
